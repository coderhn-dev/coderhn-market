# true = usa datos mock locales (src/mocks). false = consume el backend real vía Axios.
VITE_USE_MOCKS=true
# URL base del backend Node.js/PostgreSQL (cuando VITE_USE_MOCKS=false)
# true = aviso de prototipo y WhatsApp sin número destino (portafolio)
VITE_DEMO_MODE=true
VITE_API_URL=http://localhost:3000/api
